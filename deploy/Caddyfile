{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	@websocket header Connection *Upgrade*
	reverse_proxy @websocket server:8787

	reverse_proxy server:8787 {
		health_uri /health
		health_interval 5s
		health_timeout 3s
		lb_try_duration 20s
		lb_try_interval 500ms
	}
}

www.{$SITE_ADDRESS} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
